{
  "framework": "nextjs",
  "regions": ["bom1"],
  "functions": {
    "app/api/imagekit/auth/route.ts": { "maxDuration": 30 },
    "app/api/payments/webhook/route.ts": { "maxDuration": 30 },
    "app/api/webhooks/razorpay/route.ts": { "maxDuration": 30 },
    "app/api/orders/[id]/invoice/route.ts": { "maxDuration": 60 },
    "app/api/admin/dashboard/route.ts": { "maxDuration": 60 }
  },
  "crons": [
    { "path": "/api/cron/cleanup", "schedule": "0 3 * * *" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" }
      ]
    }
  ]
}
