# Neon pooled connection string (host includes -pooler); used by the app at runtime.
DATABASE_URL=
# Neon direct/non-pooled connection string; migrations only.
DATABASE_URL_UNPOOLED=
# Random secret used to sign authentication cookies; generate a long random value.
JWT_SECRET=
# Public base URL of the app, for example http://localhost:3000.
NEXT_PUBLIC_APP_URL=
# Vercel deployment URL is supplied automatically and used if NEXT_PUBLIC_APP_URL is unset.
VERCEL_URL=
# Required by Vercel Cron; generate a long random value.
CRON_SECRET=
# ImageKit public key from Developer options → API keys.
IMAGEKIT_PUBLIC_KEY=
# ImageKit private key; server-only, never expose to browser code.
IMAGEKIT_PRIVATE_KEY=
# ImageKit URL endpoint from the dashboard, e.g. https://ik.imagekit.io/your_id.
IMAGEKIT_URL_ENDPOINT=
# Public key used by browser-side ImageKit uploads.
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=
# Public CDN URL endpoint used by browser-side ImageKit uploads.
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=
# Folder for product images in ImageKit.
IMAGEKIT_UPLOAD_FOLDER=/skincare-store/products
# Maximum allowed size for each image, in MB.
MAX_IMAGE_SIZE_MB=5
# Maximum number of images on one product.
MAX_IMAGES_PER_PRODUCT=8
# Razorpay key ID from the Razorpay dashboard.
RAZORPAY_KEY_ID=
# Razorpay key secret from the Razorpay dashboard.
RAZORPAY_KEY_SECRET=
# Public Razorpay key ID used by the checkout widget.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# Razorpay webhook secret configured in the Razorpay dashboard.
RAZORPAY_WEBHOOK_SECRET=
# SMTP hostname provided by your email provider.
EMAIL_HOST=
# SMTP port provided by your email provider.
EMAIL_PORT=
# SMTP username provided by your email provider.
EMAIL_USER=
# SMTP password or API credential provided by your email provider.
EMAIL_PASSWORD=
# Sender email address verified with your email provider.
EMAIL_FROM=
# Number of days after delivery in which a return can be requested.
RETURN_WINDOW_DAYS=7
# Displayed store name and email sender label.
STORE_NAME=
# ISO currency code for catalog and payments, for example INR.
CURRENCY=
# Optional Postgres-backed limiter is used by this project; these are reserved for a future Upstash limiter.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional audit-log retention; unset means keep audit records indefinitely.
AUDIT_LOG_RETENTION_DAYS=
# Node environment setting; Vercel sets this automatically.
NODE_ENV=
